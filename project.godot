config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Novo Projeto de Jogo"
run/main_scene="uid://bbt714o4nw8fy"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://scripts/main_menu_scripts/icon.svg"

[audio]

buses/default_bus_layout="uid://dyxtp740c3gs4"

[autoload]

